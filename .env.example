# Copy to .env (docker compose reads it) and fill in what you need.
# Everything is optional: with nothing set, accounts and the agent are off.

# ── Accounts ─────────────────────────────────────────────
# Set a password to turn accounts on (admins, instructors, students).
# Off = the API is open and everyone is an admin: local use only.
AE3GIS_ADMIN_PASSWORD=
# The admin's username (default: admin).
AE3GIS_ADMIN_USERNAME=
# Optional static admin bearer token for scripts (bench.sh --token).
AE3GIS_ADMIN_TOKEN=
# Labs one student may have deployed at once (0 = no limit).
AE3GIS_STUDENT_MAX_LABS=1

# ── Agent sidebar ────────────────────────────────────────
# off | anthropic (Claude) | openai (any OpenAI-compatible server, e.g. Ollama) | fake (UI work, no model)
AE3GIS_AGENT_PROVIDER=off
# Model id. Empty = claude-opus-5-5 for anthropic; required for openai.
AE3GIS_AGENT_MODEL=
# The student tutor's model (empty = AE3GIS_AGENT_MODEL).
AE3GIS_AGENT_TUTOR_MODEL=
# openai only: the server's URL, e.g. Ollama on this machine:
# http://host.docker.internal:11434/v1
AE3GIS_AGENT_BASE_URL=
# The provider's API key (empty = ANTHROPIC_API_KEY below; Ollama needs none).
AE3GIS_AGENT_API_KEY=
# Claude's API key, for AE3GIS_AGENT_PROVIDER=anthropic.
ANTHROPIC_API_KEY=

# ── Host ─────────────────────────────────────────────────
# Browser origins allowed to call the API, comma-separated (* = any).
AE3GIS_CORS_ORIGINS=*
# A name for this machine in capture/traffic/benchmark results, e.g. mac-studio.
AE3GIS_HOST_LABEL=
# Docker Hub namespaces whose node images join the catalog, comma-separated
# (empty = none).
AE3GIS_DEFAULT_REGISTRIES=tollan
