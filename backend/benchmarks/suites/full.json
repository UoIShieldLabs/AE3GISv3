{
  "name": "full",
  "description": "Everything, one after the other: the baseline sweeps, the realistic climb, the image census and 5 random-mix climbs, and the burst matrix. About two days on a 16 GB Docker Desktop VM.",
  "restart_docker": true,
  "rest_wait_s": 60,
  "items": [
    { "id": "idle", "spec": "baseline/idle-sweep.json" },
    { "id": "clients-servers", "spec": "baseline/clients-servers-sweep.json" },
    { "id": "mesh", "spec": "baseline/mesh-sweep.json" },
    { "id": "realistic-idle", "spec": "realistic/realistic-idle-sweep.json" },
    { "id": "census", "spec": "random/image-census.json" },
    {
      "id": "random-idle",
      "spec": "random/random-idle.json",
      "runs": 5,
      "seeds": [1, 2, 3, 4, 5],
      "pool_from": "census",
      "start_from_previous": 0.7
    },
    { "id": "burst-matrix", "spec": "traffic/burst-matrix.json" }
  ]
}
