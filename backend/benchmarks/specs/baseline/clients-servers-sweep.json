{
  "label": "clients to servers",
  "notes": "Every host sends 1 Mb/s of TCP to one of two servers (round-robin) while the step holds; paths cross 5-6 links. The macOS baseline of 2026-09-30 ran exactly this.",
  "topology": {
    "generate": { "servers": 2, "hosts_per_subnet": 200, "hosts_per_switch": 48, "host_type": "workstation" }
  },
  "scale": [10, 25, 50, 75, 100, 125, 150, 200, 300],
  "repetitions": 3,
  "rest_s": 30,
  "cooldown_s": 20,
  "settle_s": 20,
  "hold_s": 60,
  "monitor": { "interval_s": 5 },
  "traffic": {
    "patterns": [
      { "id": "cs", "kind": "clients_to_servers", "servers": ["srv-1", "srv-2"], "protocol": "tcp", "bitrate": "1M" }
    ],
    "interval_s": 5,
    "ramp_s": 10
  },
  "stop": { "max_mem_pct": 90, "max_psi_mem_full": 10, "min_delivered_ratio": 0.8, "max_loss_pct": 5 }
}
