{
  "label": "idle sweep",
  "notes": "Nodes deployed and reachable, no traffic: memory per node, deploy and destroy time, until the host stops coping. The macOS baseline of 2026-09-30 ran exactly this.",
  "topology": {
    "generate": { "servers": 1, "hosts_per_subnet": 200, "hosts_per_switch": 48, "host_type": "workstation" }
  },
  "scale": [10, 25, 50, 100, 200, 300, 400, 600, 800, 1000, 1200, 1400, 1600, 2000],
  "repetitions": 3,
  "rest_s": 30,
  "cooldown_s": 20,
  "settle_s": 30,
  "hold_s": 30,
  "monitor": { "interval_s": 5 },
  "stop": { "max_mem_pct": 90, "max_psi_mem_full": 10, "deploy_timeout_s": 1800, "ready_timeout_s": 300 }
}
