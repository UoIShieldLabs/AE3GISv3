{
  "label": "host mesh",
  "notes": "Every host sends 1 Mb/s of UDP to the next two hosts on a ring (and receives from two): east-west load, mostly within a subnet. The macOS baseline of 2026-09-30 ran exactly this.",
  "topology": {
    "generate": { "servers": 0, "hosts_per_subnet": 200, "hosts_per_switch": 48, "host_type": "workstation" }
  },
  "scale": [10, 25, 50, 100, 150, 200, 250, 300, 400],
  "repetitions": 3,
  "rest_s": 30,
  "cooldown_s": 20,
  "settle_s": 20,
  "hold_s": 60,
  "monitor": { "interval_s": 5 },
  "traffic": {
    "patterns": [{ "id": "mesh", "kind": "mesh", "fanout": 2, "protocol": "udp", "bitrate": "1M" }],
    "interval_s": 5,
    "ramp_s": 10
  },
  "stop": { "max_mem_pct": 90, "max_psi_mem_full": 10, "min_delivered_ratio": 0.8, "max_loss_pct": 5 }
}
